	quests: [
		{
			description: [
				"GregTech power is measured in Energy Units (EU), and recipe consumption is measured in EU per tick (EU/t)."
				"Build your EU supply through GregTech’s steam and electrical progression. Check voltage, cable capacity and machine requirements before connecting a new device."
				"Some side mods use their own power systems. Follow the relevant workshop chapter and JEI for the supply each needs."
			]
			extraquests_calendar: {
				active_quests: 3
				enabled: 0b
