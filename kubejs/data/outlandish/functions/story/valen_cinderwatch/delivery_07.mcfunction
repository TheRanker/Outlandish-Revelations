# Delivery 7, AS the completing player. No player permission elevation.
execute if entity @s[type=minecraft:player] if dimension minecraft:the_nether at @s as @e[type=minecraft:villager,tag=outlandish_valen_cinderwatch_npc,name="Valen Cinderwatch",distance=..8,sort=nearest,limit=1] at @s as @e[type=minecraft:marker,tag=outlandish_valen_cinderwatch_anchor,distance=..0.1,limit=1] at @s rotated as @s unless entity @e[type=minecraft:marker,tag=outlandish_valen_cinderwatch_anchor,distance=0.001..16] run function outlandish:story/valen_cinderwatch/repair_07
execute if entity @s[type=minecraft:player] run function outlandish:story/valen_cinderwatch/complete
